# Modelo de variáveis de ambiente do Sistema de Gerenciamento de Clínica Veterinária.
# Copie para .env e preencha localmente. NUNCA versione o .env com valores reais.

# Banco de dados PostgreSQL (decisão registrada em docs/arquitetura/decisoes.md)
DATABASE_URL=preencher_no_ambiente_local

# Autenticação (RNF01)
SECRET_KEY=preencher_no_ambiente_local

# Serviço de notificações (RF05)
NOTIFICACAO_EMAIL_API_KEY=preencher_no_ambiente_local
NOTIFICACAO_SMS_API_KEY=preencher_no_ambiente_local
